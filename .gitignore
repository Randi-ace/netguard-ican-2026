# Prevent accidental recommit of nested/legacy extension copies.
/extension/adchacha/
/extension/SmartGuard-NetGuard/

# Safeguards: competition demos, documentation, and test pages
!/demos/**/*.html
!/demos/**/*.css
!/demos/**/*.js
!/tests/browser/*.html
!/tests/backend/*.py
!/tests/extension/*.js
!/docs/AI_DEMO_GUIDE.md
!/README.md
!/requirements.txt
!/**/*[Tt][Ee][Ss][Tt]*.md

