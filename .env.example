# 配置模板：当前程序不会自动加载 .env。
# 推荐按 README 在启动 Flask 的同一个 PowerShell 会话中显式设置环境变量。
# 不要在此文件中填写或提交真实密码、Token、API Key 或其他 secret。

# ======================
# Flask（本地示例占位符）
# ======================
SECRET_KEY=replace_with_a_local_random_secret

# ======================
# MySQL（请替换为本机账户；密码为占位符）
# ======================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DB=net_guard

# ======================
# 正式比赛 TextRiskModel / Risk Fusion
# ======================
AI_TEXT_MODEL_ENABLED=true
AI_TEXT_MODEL_PATH=models/ai/tfidf-logreg-v2-char.joblib
AI_MODEL_VERSION=tfidf-logreg-v2-char
AI_MIN_CONFIDENCE=0.70
AI_RULE_WEIGHT=0.40
AI_WEIGHT=0.60

